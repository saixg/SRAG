# Secure Multimodal RAG — Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to version control.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/srag_dev

# --- Security ---
# Secret key for session/token signing (generate a strong random value)
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
