# Copy to .env. Never commit .env.

APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Local docker-compose Postgres, or the Supabase URI with the pooler.
#
# Supabase pooler (Supavisor) ports, for *.pooler.supabase.com:
#   5432 -> session mode     (one backend per client connection; prepared
#                             statements work; this is what we run on)
#   6543 -> transaction mode (a backend is shared between transactions)
# Pointing DATABASE_URL at 6543 is supported: the engine then sets
# statement_cache_size=0 and prepared_statement_cache_size=0 automatically
# (see Settings.db_is_transaction_pooler). Tenant isolation is unaffected
# either way, because the binding uses transaction-local set_config(..., true)
# and SET LOCAL ROLE, which Postgres reverts at COMMIT/ROLLBACK.
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/srag_dev

# --- Connection health against a remote pooler ---
# asyncpg never enables SO_KEEPALIVE, so a connection held across a long
# embedding pass sends no traffic and a NAT/firewall on the path silently drops
# it; the next INSERT dies with "connection was closed in the middle of
# operation". These re-enable keepalives and bound connection reuse.
DB_KEEPALIVE_IDLE=30
DB_KEEPALIVE_INTERVAL=10
DB_KEEPALIVE_COUNT=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Keep below Supavisor's 3600s server lifetime.
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
# Matches the server-side statement_timeout (2min on Supabase).
DB_COMMAND_TIMEOUT=120

SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
# Required in production. From Supabase Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=
# Accepted only when APP_ENV is development or testing.
DEV_AUTH_TOKEN=dev_token_123

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Pilot default. Tests and CI force hashing so they do not download the model.
EMBEDDER_PROVIDER=local
EMBEDDER_MODEL_NAME=BAAI/bge-m3
EMBEDDER_DIMENSION=1024

# memory is fine for one local process. Production must be redis or disabled.
CACHE_BACKEND=memory
REDIS_URL=

# Optional. When both are set, tenant bootstrap writes app_metadata.tenant_id.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MAX_BODY_BYTES=10485760
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_QUERY_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
