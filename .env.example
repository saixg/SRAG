# Secure Multimodal RAG â€” Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to version control.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/srag_dev

# --- Security ---
# Secret key for session/token signing (generate a strong random value)
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Google Workspace sign-in ---
# OAuth Web Client ID (public identifier; the Google client secret is not used by this ID-token flow)
GOOGLE_CLIENT_ID=
# Restrict login to the exact Google Workspace hosted domain, for example company.com
GOOGLE_HOSTED_DOMAIN=
# Comma-separated frontend origins allowed to make credentialed API requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_COOKIE_NAME=nexus_one_session
AUTH_SESSION_MAX_AGE_SECONDS=28800
